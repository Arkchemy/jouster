--- a/generated_0136.c
+++ b/generated_0136.c
@@ CheckReadDelta16Bundle (entry 0x2378d14) -- all four back-edges @@
 Applied by tools/, not by hand: every backward branch inside
 CheckReadDelta16Bundle gets its own spin counter. The function has four:

     L_2378fa0   bdnz
     L_23790c4   bdnz
     L_2378f2c   bne   (two separate sites)

 The first version of this probe instrumented only one of the two bne sites,
 on the assumption it was the obvious candidate, and never fired -- which
 looked like an absence of information but was actually the finding: the
 thread is spinning somewhere else. A bdnz loop with a garbage counter would
 never have been caught by a conditional-branch-only probe at all.

 Each detector reports which label it belongs to, dumps r23/r30/ctr/r22, and
 then forces its own loop to exit, so a hang becomes a corrupt frame that
 still reaches the screen and shows how far the decode got.

+  { /* ARKCHEMY: spin detector for the loop at L_<label> */
+    static uint32_t spin_<label> = 0;
+    if (<condition>) {
+      if (++spin_<label> > 300000u) {
+        arkchemy_probe4("BINK_SPIN_<label>", "r23", ctx->r[23], "r30", ctx->r[30],
+                        "ctr", ctx->ctr, "r22", ctx->r[22]);
+        spin_<label> = 0; ctx->r[23] = 0; ctx->ctr = 1; ctx->cr0_eq = 1;
+      }
+    } else { spin_<label> = 0; }
+  }
   if (<condition>) goto L_<label>;
